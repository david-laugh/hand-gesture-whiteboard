# Copy to .env and adjust as needed:  cp .env.example .env

# Host port exposed by gateway (container internal port is always 8000)
GATEWAY_HOST_PORT=8000

# Contract version shared by all services
SCHEMA_VERSION=1.0.0

LOG_LEVEL=info

# Internal service URLs (Docker DNS on hand-net)
VISION_URL=http://vision:8001
GESTURE_URL=http://gesture:8002
CANVAS_URL=http://canvas:8003

# vision (model is baked into the image at /opt/models; see services/vision/README.md)
VISION_MODEL_PATH=/opt/models/hand_landmarker.task
VISION_MAX_NUM_HANDS=1
VISION_MIN_HAND_DETECTION_CONFIDENCE=0.5
VISION_MIN_TRACKING_CONFIDENCE=0.5
VISION_SWAP_HANDEDNESS=false
VISION_WS_RECONNECT_INTERVAL_S=2
# gateway → vision frame input over MQTT (topic MQTT_TOPIC_PREFIX/frames/{session_id})
VISION_MQTT_ENABLED=true
VISION_MQTT_HOST=hgw-mqtt
VISION_MQTT_PORT=1883
MQTT_TOPIC_PREFIX=hgw/v1
# vision → gesture (gesture is the WebSocket server)
GESTURE_WS_URL=ws://gesture:8002/ws/landmarks

# canvas
CANVAS_WIDTH=1280
CANVAS_HEIGHT=720
